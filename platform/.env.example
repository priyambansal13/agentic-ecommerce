# agentic-commerce — platform/.env is the single source of LOCAL secrets for all three repos.
# `ac configure` copies this to .env, fills every __generate__ value, adds one DB_PASSWORD_<DB> per
# service database (from backend/services/*/package.json), asks for API keys, and then writes:
#   backend/.env                    shared non-secret settings for all services
#   backend/services/<svc>/.env     PORT, DATABASE_URL (own database + own password), the service's own secrets
#   frontend/apps/<zone>/.env.local zone settings (Kong URL, auth, shell zone URLs)

# ---------- infrastructure (docker compose) ----------
POSTGRES_PASSWORD=__generate__
REDIS_PASSWORD=__generate__
KEYCLOAK_ADMIN_PASSWORD=__generate__
MINIO_ROOT_PASSWORD=__generate__
CLICKHOUSE_PASSWORD=__generate__
LANGFUSE_SALT=__generate__
LANGFUSE_ENCRYPTION_KEY=__generate_hex64__
LANGFUSE_NEXTAUTH_SECRET=__generate__
LANGFUSE_ADMIN_PASSWORD=__generate__
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=__generate_sk__

# ---------- local npm registry (Verdaccio) for versioned shared libs ----------
AC_REGISTRY=http://localhost:54873/
AC_REGISTRY_USER=ac-dev
AC_REGISTRY_PASSWORD=__generate__
# filled by `ac infra init`
AC_REGISTRY_TOKEN=

# ---------- endpoints (host ports from infra/docker-compose.yml) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
KEYCLOAK_URL=http://localhost:58180
OPENSEARCH_URL=http://localhost:59200
OPA_URL=http://localhost:58181
KONG_URL=http://localhost:58000
NEXT_PUBLIC_APP_URL=http://localhost:3300

# Keycloak clients (dev secrets match infra/keycloak/realm-*.json — change both for shared environments)
KEYCLOAK_WEB_CLIENT_SECRET=dev-web-secret
KEYCLOAK_WEB_ADMIN_CLIENT_SECRET=dev-web-admin-secret
KEYCLOAK_AGENTS_CLIENT_SECRET=dev-agents-secret
KEYCLOAK_SERVICES_CLIENT_SECRET=dev-services-secret
# user service: grants the `seller` realm role once KYC is verified (client user-service, manage-users)
KEYCLOAK_USER_SERVICE_CLIENT_SECRET=dev-user-service-secret

# ---------- AI (given only to services that declare them: agents, search) ----------
OPENAI_API_KEY=
# auto = OpenAI when OPENAI_API_KEY is set, else the deterministic offline provider (dev/CI/evals) · openai · offline
MODEL_PROVIDER=auto
MODEL_FAST=gpt-4.1-mini
MODEL_SMART=gpt-4.1
MODEL_VISION=gpt-4.1
MODEL_EMBED=text-embedding-3-small
EMBED_DIMENSIONS=512

# ---------- payments, test mode (given only to the payment service) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# testpay: built-in TEST payment gateway (no real money) — signs its webhooks with this secret
TESTPAY_WEBHOOK_SECRET=__generate__
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- web zones ----------
AUTH_SECRET=__generate__

# ---------- optional: clone instead of init when the repos are missing (ac repos) ----------
AC_BACKEND_REPO=
AC_FRONTEND_REPO=

# ---------- cloud (ac tf <env> …) ----------
TF_STATE_BUCKET=
AWS_REGION=ap-south-1

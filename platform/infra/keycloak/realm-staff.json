{
  "realm": "staff",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 900,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Platform administrator"
      },
      {
        "name": "support",
        "description": "Approves refunds, handles tickets"
      },
      {
        "name": "fraud-analyst",
        "description": "Investigates fraud alerts"
      },
      {
        "name": "finance",
        "description": "Second approver for high-value refunds, payouts"
      },
      {
        "name": "moderator",
        "description": "Catalog moderation"
      },
      {
        "name": "compliance",
        "description": "Seller KYC verification (GST/PAN, bank)"
      },
      {
        "name": "brand-team",
        "description": "Brand Registry approvals"
      },
      {
        "name": "category-team",
        "description": "Gated category approvals"
      }
    ]
  },
  "defaultRoles": [],
  "clients": [
    {
      "clientId": "web-admin",
      "name": "web-admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-web-admin-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3300/*"
      ],
      "webOrigins": [
        "http://localhost:3300"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3300/*"
      }
    },
    {
      "clientId": "agents",
      "name": "Agent Gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-agents-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      }
    }
  ],

# One-off ECS task that creates, per microservice, a login role svc_<db> and a database ac_<db> owned
# by it (CONNECT revoked from PUBLIC, so services cannot reach each other's databases), plus the
# extensions services use. Idempotent: re-run after adding a service or rotating a password.
#   aws ecs run-task --cluster <cluster> --task-definition <family> --launch-type FARGATE \
#     --network-configuration 'awsvpcConfiguration={subnets=[<private-subnet>],securityGroups=[<app-sg>]}'
# (exact command is in the platform outputs: db_bootstrap_run_commands)

data "aws_region" "current" {}

locals {
  # env var holding each service's password (injected from its own database secret, JSON key "password")
  pw_env = { for d in var.databases : d.database => "PW_${upper(replace(d.database, "-", "_"))}" }

  script = <<-SH
    #!/bin/sh
    # GENERATED by Terraform (modules/db-bootstrap) — do not edit in SSM by hand.
    set -eu
    export PGHOST="$DB_HOST" PGPORT=5432 PGUSER="$MASTER_USERNAME" PGPASSWORD="$MASTER_PASSWORD" PGSSLMODE=require PGDATABASE=postgres

    ensure() { # role database password
      psql -v ON_ERROR_STOP=1 -q -v role="$1" -v db="$2" -v pw="$3" <<'SQL'
    SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'role', :'pw') WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'role') \gexec
    SELECT format('ALTER ROLE %I WITH LOGIN PASSWORD %L', :'role', :'pw') \gexec
    SELECT format('GRANT %I TO %I', :'role', current_user) \gexec
    SELECT format('CREATE DATABASE %I OWNER %I', :'db', :'role') WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'db') \gexec
    SELECT format('REVOKE ALL ON DATABASE %I FROM PUBLIC', :'db') \gexec
    SELECT format('GRANT CONNECT, TEMPORARY ON DATABASE %I TO %I', :'db', :'role') \gexec
    SQL
      psql -v ON_ERROR_STOP=1 -q -d "$2" -c 'CREATE EXTENSION IF NOT EXISTS vector; CREATE EXTENSION IF NOT EXISTS pgcrypto; CREATE EXTENSION IF NOT EXISTS pg_trgm;'
      echo "ok: $2 (owner $1)"
    }

    %{for d in var.databases~}
    ensure svc_${d.database} ac_${d.database} "$${${local.pw_env[d.database]}}"
    %{endfor~}
    echo "db-bootstrap complete"
  SH
}

resource "aws_ssm_parameter" "script" {
  name        = "/${var.name}/db-bootstrap/script"
  description = "Generated role/database bootstrap script for ${var.name}"
  type        = "String"
  tier        = "Standard" # 4 KB is plenty for ~20 databases; switch to Advanced (8 KB) beyond that
  value       = local.script
  tags        = var.tags
}

resource "aws_cloudwatch_log_group" "this" {
  name              = "/ecs/${var.name}/db-bootstrap"
  retention_in_days = var.log_retention_days
  tags              = var.tags
}

data "aws_iam_policy_document" "assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["ecs-tasks.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "execution" {
  name               = "${var.name}-db-bootstrap-exec"
  assume_role_policy = data.aws_iam_policy_document.assume.json
  tags               = var.tags
}

resource "aws_iam_role_policy_attachment" "execution" {
  role       = aws_iam_role.execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

data "aws_iam_policy_document" "execution" {
  statement {
    sid       = "Secrets"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = distinct(concat([var.master_secret_arn], [for d in var.databases : d.secret_arn]))
  }
  statement {
    sid       = "Script"
    actions   = ["ssm:GetParameters"]
    resources = [aws_ssm_parameter.script.arn]
  }
}

resource "aws_iam_role_policy" "execution" {
  name   = "bootstrap"
  role   = aws_iam_role.execution.id
  policy = data.aws_iam_policy_document.execution.json
}

resource "aws_ecs_task_definition" "this" {
  family                   = "${var.name}-db-bootstrap"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = 256
  memory                   = 512
  execution_role_arn       = aws_iam_role.execution.arn

  runtime_platform {
    operating_system_family = "LINUX"
    cpu_architecture        = "ARM64"
  }

  container_definitions = jsonencode([{
    name       = "db-bootstrap"
    image      = var.image
    essential  = true
    entryPoint = ["sh", "-c"]
    command    = ["printf '%s' \"$BOOTSTRAP_SCRIPT\" > /tmp/bootstrap.sh && sh /tmp/bootstrap.sh"]
    environment = [
      { name = "DB_HOST", value = var.db_host },
      { name = "MASTER_USERNAME", value = var.master_username },
    ]
    secrets = concat(
      [
        { name = "MASTER_PASSWORD", valueFrom = "${var.master_secret_arn}:password::" },
        { name = "BOOTSTRAP_SCRIPT", valueFrom = aws_ssm_parameter.script.arn },
      ],
      [for d in var.databases : { name = local.pw_env[d.database], valueFrom = "${d.secret_arn}:password::" }],
    )
    logConfiguration = {
      logDriver = "awslogs"
      options = {
        awslogs-group         = aws_cloudwatch_log_group.this.name
        awslogs-region        = data.aws_region.current.region
        awslogs-stream-prefix = "db-bootstrap"
      }
    }
  }])

  tags = var.tags
}

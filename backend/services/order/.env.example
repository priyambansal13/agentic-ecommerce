# order service — copy to .env (`ac configure` generates it). Real env vars override this file.
# Shared non-secret settings come from backend/.env.
SERVICE_NAME=order
PORT=4105
# own database — no other service can connect to it
DATABASE_URL=postgresql://svc_orders:<password>@localhost:55432/ac_orders
# sync calls to catalog, inventory, fraud, payment via Kong with a client-credentials token (realm role `service`)
SERVICES_CLIENT_ID=services
SERVICES_CLIENT_SECRET=<from ac configure>
SERVICE_CALLS=catalog,inventory,fraud,payment

# payment service — copy to .env (`ac configure` generates it). Real env vars override this file.
# Shared non-secret settings come from backend/.env.
SERVICE_NAME=payment
PORT=4106
# own database — no other service can connect to it
DATABASE_URL=postgresql://svc_payments:<password>@localhost:55432/ac_payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_PUBLISHABLE_KEY=
TESTPAY_WEBHOOK_SECRET=

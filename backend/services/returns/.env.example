# returns service — copy to .env (`ac configure` generates it). Real env vars override this file.
# Shared non-secret settings come from backend/.env.
SERVICE_NAME=returns
PORT=4107
# own database — no other service can connect to it
DATABASE_URL=postgresql://svc_returns:<password>@localhost:55432/ac_returns
# own bucket ac-returns — MinIO user svc-returns can access only this bucket
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=ac-returns
S3_ACCESS_KEY=svc-returns
S3_SECRET_KEY=<generated>
# sync calls to order, payment, catalog via Kong with a client-credentials token (realm role `service`)
SERVICES_CLIENT_ID=services
SERVICES_CLIENT_SECRET=<from ac configure>
SERVICE_CALLS=order,payment,catalog

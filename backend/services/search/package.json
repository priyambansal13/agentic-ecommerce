{
  "name": "@ac/search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "ac": {
    "kind": "service",
    "port": 4103,
    "database": null,
    "owner": "team-catalog",
    "publishes": [],
    "consumes": [
      "catalog.events",
      "inventory.events"
    ],
    "secrets": [
      "OPENAI_API_KEY"
    ]
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ac/contracts": "workspace:^",
    "@ac/nest-common": "workspace:^",
    "@nestjs/common": "~12.1.3",
    "@nestjs/core": "~12.1.3",
    "@nestjs/platform-fastify": "~12.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.9",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "~12.1.3",
    "@types/node": "^24.0.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}

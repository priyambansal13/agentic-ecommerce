# catalog service — copy to .env (`ac configure` generates it). Real env vars override this file.
# Shared non-secret settings come from backend/.env.
SERVICE_NAME=catalog
PORT=4102
# own database — no other service can connect to it
DATABASE_URL=postgresql://svc_catalog:<password>@localhost:55432/ac_catalog
# own bucket ac-catalog — MinIO user svc-catalog can access only this bucket
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=ac-catalog
S3_ACCESS_KEY=svc-catalog
S3_SECRET_KEY=<generated>

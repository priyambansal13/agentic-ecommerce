# agents service — copy to .env (`ac configure` generates it). Real env vars override this file.
# Shared non-secret settings come from backend/.env.
SERVICE_NAME=agents
PORT=4300
# own database — no other service can connect to it
DATABASE_URL=postgresql://svc_agents:<password>@localhost:55432/ac_agents
OPENAI_API_KEY=
KEYCLOAK_AGENTS_CLIENT_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

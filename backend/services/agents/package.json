{
  "name": "@ac/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "ac": {
    "kind": "agents",
    "port": 4300,
    "database": "agents",
    "owner": "team-ai",
    "publishes": [
      "agent.events"
    ],
    "consumes": [
      "returns.events",
      "fraud.events",
      "catalog.events",
      "admin.events"
    ],
    "secrets": [
      "OPENAI_API_KEY",
      "KEYCLOAK_AGENTS_CLIENT_SECRET",
      "LANGFUSE_PUBLIC_KEY",
      "LANGFUSE_SECRET_KEY"
    ]
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests",
    "evals": "node dist/evals/run.js"
  },
  "dependencies": {
    "@ac/contracts": "workspace:^",
    "@ac/nest-common": "workspace:^",
    "@ag-ui/core": "1.0.3",
    "@ag-ui/encoder": "1.0.3",
    "@langchain/core": "^1.2.18",
    "@langchain/langgraph": "^1.5.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.0",
    "@langchain/openai": "^1.6.2",
    "@nestjs/common": "~12.1.3",
    "@nestjs/core": "~12.1.3",
    "@nestjs/platform-fastify": "~12.1.3",
    "@nestjs/typeorm": "^12.0.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.3",
    "@nestjs/cli": "^12.0.9",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "~12.1.3",
    "@types/node": "^24.0.0",
    "fastify": "^5.12.7",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}

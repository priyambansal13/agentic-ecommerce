# syntax=docker/dockerfile:1.7
# fraud microservice image — build from the backend repo root:
#   docker build -f services/fraud/Dockerfile -t ac/fraud .        (or: ac docker build fraud)
# GENERATED by `pnpm gen sync` — edit scripts/gen.mjs, not this file.
FROM node:24-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true
RUN npm install -g pnpm@12.14.0 >/dev/null
WORKDIR /repo

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN pnpm fetch
COPY . .
RUN pnpm install --offline --frozen-lockfile --filter "@ac/fraud..."
RUN pnpm exec turbo run build --filter "@ac/fraud..."
RUN pnpm deploy --legacy --filter "@ac/fraud" --prod /out

FROM node:24-slim AS runtime
ENV NODE_ENV=production PORT=4108
WORKDIR /app
COPY --from=build --chown=node:node /out .
USER node
EXPOSE 4108
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD node -e "fetch('http://127.0.0.1:4108/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]

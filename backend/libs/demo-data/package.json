{
  "name": "@ac/demo-data",
  "version": "0.1.0",
  "description": "Deterministic demo universe (sellers, buyers, products, orders, refunds, alerts …). Each service's seed writes ONLY its own slice into its own database.",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^6.0.2", "vitest": "^4.1.2" }
}

# syntax=docker/dockerfile:1.7
# shell micro-frontend image — build from the frontend repo root:
#   docker build -f apps/shell/Dockerfile -t ac/zone-shell .     (or: ac docker build shell)
# @ac/* libraries come from the registry (AC_REGISTRY). GENERATED by `pnpm gen sync`.
FROM node:24-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true NEXT_TELEMETRY_DISABLED=1
RUN npm install -g pnpm@12.14.0 >/dev/null
WORKDIR /repo

FROM base AS build
ARG AC_REGISTRY=http://host.docker.internal:54873/
# rewrites are resolved at build time → zone URLs are build args (Kubernetes Service names zone-<name> in ac-apps)
ARG ZONE_STOREFRONT_URL=http://zone-storefront:3301
ENV ZONE_STOREFRONT_URL=$ZONE_STOREFRONT_URL
ARG ZONE_ACCOUNT_URL=http://zone-account:3302
ENV ZONE_ACCOUNT_URL=$ZONE_ACCOUNT_URL
ARG ZONE_SELLER_URL=http://zone-seller:3303
ENV ZONE_SELLER_URL=$ZONE_SELLER_URL
ARG ZONE_ADMIN_URL=http://zone-admin:3304
ENV ZONE_ADMIN_URL=$ZONE_ADMIN_URL
COPY . .
# CI passes the registry auth as a BuildKit secret (never stored in a layer): --secret id=npmrc,src=.npmrc
RUN --mount=type=secret,id=npmrc,required=false \
    if [ -f /run/secrets/npmrc ]; then cp /run/secrets/npmrc .npmrc; else printf '@ac:registry=%s\n' "$AC_REGISTRY" > .npmrc; fi \
    && pnpm install --frozen-lockfile --filter "@ac/zone-shell..."
RUN pnpm exec turbo run build --filter "@ac/zone-shell..."

FROM node:24-slim AS runtime
ENV NODE_ENV=production PORT=3300 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --from=build --chown=node:node /repo/apps/shell/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/shell/.next/static ./apps/shell/.next/static
COPY --from=build --chown=node:node /repo/apps/shell/public ./apps/shell/public
USER node
EXPOSE 3300
CMD ["node", "apps/shell/server.js"]

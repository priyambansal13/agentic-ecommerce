# syntax=docker/dockerfile:1.7
# admin micro-frontend image — build from the frontend repo root:
#   docker build -f apps/admin/Dockerfile -t ac/zone-admin .     (or: ac docker build admin)
# @ac/* libraries come from the registry (AC_REGISTRY). GENERATED by `pnpm gen sync`.
FROM node:24-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true NEXT_TELEMETRY_DISABLED=1
RUN npm install -g pnpm@12.14.0 >/dev/null
WORKDIR /repo

FROM base AS build
ARG AC_REGISTRY=http://host.docker.internal:54873/
COPY . .
# CI passes the registry auth as a BuildKit secret (never stored in a layer): --secret id=npmrc,src=.npmrc
RUN --mount=type=secret,id=npmrc,required=false \
    if [ -f /run/secrets/npmrc ]; then cp /run/secrets/npmrc .npmrc; else printf '@ac:registry=%s\n' "$AC_REGISTRY" > .npmrc; fi \
    && pnpm install --frozen-lockfile --filter "@ac/zone-admin..."
RUN pnpm exec turbo run build --filter "@ac/zone-admin..."

FROM node:24-slim AS runtime
ENV NODE_ENV=production PORT=3304 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --from=build --chown=node:node /repo/apps/admin/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build --chown=node:node /repo/apps/admin/public ./apps/admin/public
USER node
EXPOSE 3304
CMD ["node", "apps/admin/server.js"]
